# ---- ElevenLabs (obligatoire pour parler à l'agent) ----
# Clé API : https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Agent Conversational AI (créé dans le dashboard ou via `pnpm create-agent`)
ELEVENLABS_AGENT_ID=
# Numéro importé dans ElevenLabs (Twilio ou SIP) pour les appels sortants — optionnel
ELEVENLABS_PHONE_NUMBER_ID=
# twilio (défaut) ou sip_trunk, selon le type du numéro importé
ELEVENLABS_PHONE_PROVIDER=twilio
# Secret du webhook post-appel (Settings → Webhooks) — optionnel mais recommandé
ELEVENLABS_WEBHOOK_SECRET=
# Voix utilisée par `pnpm create-agent` — optionnel (sinon la voix par défaut)
ELEVENLABS_VOICE_ID=
# Prénom de la personne qui fera la démo humaine ; l'agent propose un RDV avec elle
CALLER_NAME=Alexandre

# ---- Note vocale (optionnel) ----
# ELEVENLABS_VOICE_ID ci-dessus sert aussi à la note vocale MP3/OGG (Text to Speech).

# ---- Réécriture des lettres et notes vocales par LLM (optionnel) ----
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- Export lemlist (optionnel) : ajoute le prospect à une campagne avec les liens en variables ----
LEMLIST_API_KEY=
LEMLIST_CAMPAIGN_ID=

# ---- WhatsApp Cloud API (optionnel) : envoi de la note vocale par lien ----
# Sans ces variables, l'app propose un lien wa.me et le fichier OGG à joindre à la main.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0

# ---- Persistance (optionnel) ----
# Sans Redis, la démo tourne en mémoire : les données repartent du jeu de test
# à chaque redémarrage (et à chaque nouvelle instance serverless sur Vercel).
# Sur Vercel : Marketplace → Upstash Redis ; les deux paires de noms sont acceptées.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Outils appelés par l'agent pendant l'appel (optionnel) ----
# Si défini, /api/tools/book-meeting exige l'en-tête `x-tool-secret`.
TOOL_SECRET=

# URL publique de l'app, affichée dans la page Agent pour configurer le webhook.
NEXT_PUBLIC_APP_URL=http://localhost:3000
