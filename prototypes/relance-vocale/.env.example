# ---- ElevenLabs (obligatoire pour parler à l'agent) ----
# Clé API : https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Les deux agents, créés ou mis à jour par `pnpm sync-agents` (qui écrit leurs identifiants dans .env.local)
# Prospection : appelle les agences d'intérim
ELEVENLABS_AGENT_ID=
# Relance : appelle les clients de l'agence au sujet d'une facture échue
ELEVENLABS_RELANCE_AGENT_ID=
# Numéro importé dans ElevenLabs (Twilio ou SIP) pour les appels sortants — optionnel
ELEVENLABS_PHONE_NUMBER_ID=
# twilio (défaut) ou sip_trunk, selon le type du numéro importé
ELEVENLABS_PHONE_PROVIDER=twilio
# Secret du webhook post-appel (Settings → Webhooks). Obligatoire en production : sans lui le webhook répond 503.
# En local il reste facultatif, l'app relit l'analyse de chaque appel elle-même.
ELEVENLABS_WEBHOOK_SECRET=
# Voix des deux agents et de la note vocale
ELEVENLABS_VOICE_ID=
# Prénom de la personne qui fera la démo humaine ; l'agent propose un RDV avec elle
CALLER_NAME=Alexandre

# ---- Accès (obligatoire en ligne) ----
# Code partagé qui protège l'espace interne : l'app lance de vrais appels.
# Sans cette variable tout est ouvert (développement local).
APP_ACCESS_CODE=
# Mettre 1 pour autoriser « Appelez-moi » sur la page publique /l/<token> :
# n'importe qui avec le lien peut alors faire composer le numéro qu'il saisit.
PUBLIC_CALLBACK=

# ---- Note vocale (optionnel) ----
# ELEVENLABS_VOICE_ID ci-dessus sert aussi à la note vocale MP3/OGG (Text to Speech).

# ---- Réécriture des lettres et notes vocales par LLM (optionnel) ----
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- Export lemlist (optionnel) : ajoute le prospect à une campagne avec les liens en variables ----
LEMLIST_API_KEY=
LEMLIST_CAMPAIGN_ID=

# ---- WhatsApp Cloud API (optionnel) : envoi de la note vocale par lien ----
# Sans ces variables, l'app propose un lien wa.me et le fichier OGG à joindre à la main.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0

# ---- Persistance (optionnel) ----
# Sans Redis, la démo tourne en mémoire : les données repartent du jeu de test
# à chaque redémarrage (et à chaque nouvelle instance serverless sur Vercel).
# Sur Vercel : Marketplace → Upstash Redis ; les deux paires de noms sont acceptées.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---- Outils appelés par l'agent pendant l'appel (optionnel) ----
# Exigé par /api/tools/book-meeting dans l'en-tête `x-tool-secret`. Obligatoire en production : sans lui l'outil répond 503.
TOOL_SECRET=

# URL publique de l'app : QR codes, liens de réponse, webhook. Sur Vercel, le domaine de production est pris par défaut.
NEXT_PUBLIC_APP_URL=http://localhost:3000
